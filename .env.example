# Names and descriptions only. Copy to .env.local and fill in the values. Never commit real values.

# Public site address, used for canonical, hreflang and sitemap URLs.
# Use the *.vercel.app address until the production domain exists.
NEXT_PUBLIC_SITE_URL=

# Sanity project (public identifiers, not secrets).
NEXT_PUBLIC_SANITY_PROJECT_ID=
NEXT_PUBLIC_SANITY_DATASET=
NEXT_PUBLIC_SANITY_API_VERSION=

# SECRET: shared secret that signs the Sanity publish webhook sent to /api/revalidate.
SANITY_REVALIDATE_SECRET=

# Google Analytics 4 measurement id (public by nature). Loaded only after the visitor accepts consent.
NEXT_PUBLIC_GA_MEASUREMENT_ID=

# EasyWeek booking widget script address and the official booking page used as the fallback link.
NEXT_PUBLIC_EASYWEEK_WIDGET_URL=
NEXT_PUBLIC_EASYWEEK_BOOKING_URL=

# Studio (read by studio/sanity.config.ts, set in studio/.env, never committed).
# Sanity project id and dataset of the owner's project; same values as the public ones above.
SANITY_STUDIO_PROJECT_ID=
SANITY_STUDIO_DATASET=

# Used only by the daily EasyWeek check (scripts/check-easyweek.mjs and its GitHub workflow), never by the site.
# A Sanity token that can write the "Barber availability" document. Without it the check only reports.
SANITY_AVAILABILITY_TOKEN=
